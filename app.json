{
  "expo": {
    "name": "Tip or Skip",
    "slug": "tip-or-skip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.troyharris.tiporskip.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tiporskip.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#182322",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#182322"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tip or Skip uses the camera to read the receipt you photograph, so it can split the check by item. The photo is read on your phone and is not uploaded.",
          "photosPermission": "Tip or Skip reads the receipt photo you choose, so it can split the check by item. The photo is read on your phone and is not uploaded.",
          "microphonePermission": false
        }
      ]
    ],
    "primaryColor": "#182322",
    "owner": "troysnew",
    "extra": {
      "eas": {
        "projectId": "fbb172ff-3888-4236-8f45-9e89cdc265e9"
      }
    }
  }
}
